    "from turtle import *\n",
    "from colorsys import *\n",
    "setpos(0,80)\n",
    "speed(0)\n",
    "bgcolor('black')\n",
    "pensize(2)\n",
    "h=0.71\n",
    "for i in range(150):\n",
    "    c=hsv_to_rgb(h,1,1)\n",
    "    color(c)\n",
    "    h+=0.004\n",
    "    circle(140-1,90)\n",
    "    lt(90)\n",
    "    lt(20)\n",
    "    circle(140-1,90)\n",
    "    lt(18)\n",
    "hideturtle()\n",
    "done()    "
